#include <windows.h>
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Eduard Serra Tuneu"
   VALUE "FileDescription", "Auto Typer - timed keyboard input"
   VALUE "FileVersion", "1.2.0"
   VALUE "InternalName", "AutoTyper"
   VALUE "OriginalFilename", "AutoTyper.exe"
   VALUE "ProductName", "Auto Typer"
   VALUE "ProductVersion", "1.2.0"
   VALUE "LegalCopyright", "Copyright (C) 2026 Eduard Serra Tuneu"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
